\fs20 AC3(:,1) = (1:n)';
\fs24 \

\fs20 AC4(:,1) = (1:n)';
\fs24 \

\fs20  
\fs24 \

\fs20 \cf2 for\cf0  i=1:n,
\fs24 \

\fs20     Ntable(i,2) = mean(I(~isnan(I) & J==i));
\fs24 \

\fs20     Ntable(i,3) = mean(I(J==i & F==2 & ~isnan(I)));
