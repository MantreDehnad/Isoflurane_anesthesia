\fs20 \cf2 function\cf0  makeNormSWA_Baseline(handles)
\fs24 \

\fs20 h = handles.output;
\fs24 \

\fs20  
\fs24 \

\fs20 A = getappdata(h,\cf4 'EpochNum'\cf0 );
\fs24 \

\fs20 B = getappdata(h,\cf4 'TimeStr'\cf0 );
