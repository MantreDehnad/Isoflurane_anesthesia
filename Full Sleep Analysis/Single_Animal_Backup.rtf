\fs20 E = getappdata(h,\cf4 'Gamma'\cf0 );
\fs24 \

\fs20 F = getappdata(h,\cf4 'AdjState'\cf0 );
\fs24 \

\fs20 G = getappdata(h,\cf4 'AllEpLen'\cf0 );
\fs24 \

\fs20 mGamma = mean(E(~isnan(E)));
\fs24 \

\fs20 H = ones(numel(A),1)*mGamma;
\fs24 \

\fs20 I = NaN(numel(A),1);
\fs24 \

\fs20 I(~isnan(D)) = D(~isnan(D))/mGamma;
\fs24 \

\fs20 J = getappdata(h,\cf4 'TimeBins'\cf0 );
\fs24 \

\fs20  
\fs24 \

\fs20 L2 = mGamma;
\fs24 \

\fs20 L6 = mean(D(C==2 & ~isnan(D)));
