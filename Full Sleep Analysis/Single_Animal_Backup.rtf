\fs20 \cf3 %creates Adjusted State sheet
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf2 function\cf0  makeAdjustedState(handles)
\fs24 \

\fs20  
\fs24 \

\fs20 h= handles.output;
\fs24 \

\fs20 EpStart = getappdata(h,\cf4 'EpStart'\cf0 );
\fs24 \

\fs20 EpLen = getappdata(h,\cf4 'EpLen'\cf0 );
\fs24 \

\fs20 EpState = getappdata(h,\cf4 'EpState'\cf0 );
\fs24 \

\fs20 TimeStr = getappdata(h,\cf4 'TimeStr'\cf0 );
\fs24 \

\fs20 EpochNum = getappdata(h,\cf4 'EpochNum'\cf0 );
\fs24 \

\fs20  
\fs24 \

\fs20 EpochDur = get(handles.Epoch_Dur_Pop,\cf4 'Value'\cf0 );
\fs24 \

\fs20 BinWidth = get(handles.Bin_Width_Pop,\cf4 'Value'\cf0 )*(1800/EpochDur);
\fs24 \

\fs20 BinStart = get(handles.Bin_Start_Pop,\cf4 'Value'\cf0 );
\fs24 \

\fs20 N = numel(EpochNum);
\fs24 \

\fs20  
\fs24 \

\fs20 output = cell(N+1,15);
\fs24 \

\fs20 output(2:end,1) = num2cell(EpochNum);
\fs24 \

\fs20 output(2:end,2) = cellstr(TimeStr);
\fs24 \

\fs20  
\fs24 \

\fs20 \cf2 if\cf0  get(handles.Type_Pop,\cf4 'Value'\cf0 )==1
\fs24 \

\fs20     \cf2 if\cf0  isfield(getappdata(h),\cf4 'TM_File'\cf0 )
\fs24 \

\fs20         TM = xlsread(getappdata(h,\cf4 'TM_File'\cf0 ));
\fs24 \

\fs20         I = nan(N,1);
\fs24 \

\fs20         I(1:size(TM,1)) = TM(:,2);
\fs24 \

\fs20     \cf2 else
\fs24 \cf0 \

\fs20         I = ones(N,1);
\fs24 \

\fs20         \cf2 if\cf0  BinStart>1
\fs24 \

\fs20             I(1:BinStart-1) = NaN;
\fs24 \

\fs20         \cf2 end
\fs24 \cf0 \

\fs20         timer = getappdata(h,\cf4 'Timer'\cf0 )/3600;
\fs24 \

\fs20         \cf2 for\cf0  i=1:floor(max(timer)),
\fs24 \

\fs20             si = find(timer>=(6*i - 2),1,\cf4 'first'\cf0 )+(BinStart-1);
\fs24 \

\fs20             ei = find(timer<(6*i),1,\cf4 'last'\cf0 )+(BinStart-1);
\fs24 \

\fs20             \cf2 if\cf0  ei>=length(I)
\fs24 \

\fs20                 I(si:end) = 0;
\fs24 \

\fs20             \cf2 else
\fs24 \cf0 \

\fs20                 I(si:ei) = 0;
\fs24 \

\fs20             \cf2 end
\fs24 \cf0 \

\fs20         \cf2 end
\fs24 \cf0 \

\fs20     \cf2 end
\fs24 \cf0 \

\fs20     setappdata(h,\cf4 'TMData'\cf0 ,I);
\fs24 \

\fs20     
\fs24 \

\fs20     \cf3 %make bins around TM data
\fs24 \cf0 \

\fs20     Bins = nan(N,1);
\fs24 \

\fs20     \cf2 for\cf0  i=1:fix((N-BinStart)/BinWidth),
\fs24 \

\fs20         Bins(BinStart+(i-1)*BinWidth:BinStart+i*BinWidth-1) = i;
\fs24 \

\fs20     \cf2 end
\fs24 \cf0 \

\fs20     Bins(BinStart+i*BinWidth:end) = i+1;
\fs24 \

\fs20     
\fs24 \

\fs20     Bins(isnan(I)) = NaN;
\fs24 \

\fs20     \cf2 for\cf0  i=unique(Bins(~isnan(Bins)))',
\fs24 \

\fs20         percOn = sum(I(Bins==i))/sum(Bins==i);
\fs24 \

\fs20         
\fs24 \

\fs20         \cf2 if\cf0  percOn>0 && percOn<1
\fs24 \

\fs20             \cf2 if\cf0  percOn<.5
\fs24 \

\fs20                 toTrim = 1;
\fs24 \

\fs20             \cf2 else
\fs24 \cf0 \

\fs20                 toTrim = 0;
\fs24 \

\fs20             \cf2 end
\fs24 \cf0 \

\fs20             \cf3 %trim beginning
\fs24 \cf0 \

\fs20             \cf2 if\cf0  i>1
\fs24 \

\fs20                 si = find(Bins==i,1,\cf4 'first'\cf0 );
\fs24 \

\fs20                 ti = find(I(Bins==i)==(~toTrim),1,\cf4 'first'\cf0 )-1;
\fs24 \

\fs20                 Bins(si:si+ti-1) = i-1;
\fs24 \

\fs20             \cf2 end
\fs24 \cf0 \

\fs20             \cf3 %trim end
\fs24 \cf0 \

\fs20             \cf2 if\cf0  i<max(unique(Bins(~isnan(Bins)))),
\fs24 \

\fs20                 si = find(Bins==i,1,\cf4 'first'\cf0 );
\fs24 \

\fs20                 ei = find(Bins==i,1,\cf4 'last'\cf0 );
\fs24 \

\fs20                 ti = find(I(Bins==i)==(~toTrim),1,\cf4 'last'\cf0 )+1;
\fs24 \

\fs20                 Bins(si+ti-1:ei) = i+1;
\fs24 \

\fs20             \cf2 end
\fs24 \cf0 \

\fs20         \cf2 end
\fs24 \cf0 \

\fs20     \cf2 end
\fs24 \cf0 \

\fs20     
\fs24 \

\fs20     \cf3 %equalize bins
\fs24 \cf0 \

\fs20     \cf2 for\cf0  i=1:max(unique(Bins(~isnan(Bins))))-1,
\fs24 \

\fs20         \cf2 if\cf0  I(find(Bins==i,1,\cf4 'first'\cf0 ))==I(find(Bins==i+1,1,\cf4 'first'\cf0 )),
\fs24 \

\fs20             si = find(Bins==i,1,\cf4 'first'\cf0 );
\fs24 \

\fs20             ei = find(Bins==i+1,1,\cf4 'last'\cf0 );
\fs24 \

\fs20             tN = ei-si+1;
\fs24 \

\fs20             mi = fix(tN/2);
\fs24 \

\fs20             Bins(si:si+mi-1)=i;
\fs24 \

\fs20             Bins(si+mi:ei)=i+1;
\fs24 \

\fs20         \cf2 end
\fs24 \cf0 \

\fs20     \cf2 end
\fs24 \cf0 \

\fs20     
\fs24 \

\fs20 \cf2 else
\fs24 \cf0 \

\fs20     Bins = nan(N,1);
\fs24 \

\fs20     \cf2 for\cf0  i=1:fix((N-BinStart)/BinWidth),
\fs24 \

\fs20         Bins(BinStart+(i-1)*BinWidth:BinStart+i*BinWidth-1) = i;
\fs24 \

\fs20     \cf2 end
\fs24 \cf0 \

\fs20     Bins(BinStart+i*BinWidth:end) = i+1;
\fs24 \

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 \cf2  
\fs24 \cf0 \

\fs20 \cf2  
\fs24 \cf0 \

\fs20 output(2:end,3) = num2cell(Bins);
\fs24 \

\fs20 output(2:end,13) = num2cell(Bins);
\fs24 \

\fs20  
\fs24 \

\fs20 col9 = NaN(N,1);
\fs24 \

\fs20 col15 = zeros(N,1);
\fs24 \

\fs20 col9(EpStart) = EpLen;
\fs24 \

\fs20 col15(EpStart)=EpLen;
\fs24 \

\fs20  
\fs24 \

\fs20 EpStateCell = cell(numel(EpochNum),1);
\fs24 \

\fs20 EpStateCell(EpStart) = arrayfun(@(x) [\cf4 'Begin '\cf0  getStateStr(x)],EpState,\cf4 'UniformOutput'\cf0 ,0);
\fs24 \

\fs20 EpStateCell(EpStart(2:end)-1) = arrayfun(@(x) [\cf4 'End '\cf0  getStateStr(x)],EpState(1:end-1),\cf4 'UniformOutput'\cf0 ,0);
\fs24 \

\fs20  
\fs24 \

\fs20 AllEpLen = col9;
\fs24 \

\fs20 AllStateCell = EpStateCell;
\fs24 \

\fs20 AdjState = zeros(N,1);
\fs24 \

\fs20  
\fs24 \

\fs20 \cf2 for\cf0  i=1:numel(EpStart),
\fs24 \

\fs20     AllEpLen(EpStart(i):EpStart(i)+EpLen(i)-1) = EpLen(i);
\fs24 \

\fs20     AllStateCell(EpStart(i):EpStart(i)+EpLen(i)-1) = EpStateCell(EpStart(i));
\fs24 \

\fs20     AdjState(EpStart(i):EpStart(i)+EpLen(i)-1) = EpState(i);
\fs24 \

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 AllStateCell(EpStart(2:end)-1) = arrayfun(@(x) [\cf4 'End '\cf0  getStateStr(x)],EpState(1:end-1),\cf4 'UniformOutput'\cf0 ,0);
\fs24 \

\fs20  
\fs24 \

\fs20 output(2:end,6) = EpStateCell;
\fs24 \

\fs20 output(2:end,7) = AllStateCell;
\fs24 \

\fs20 output(2:end,9) = num2cell(col9);
\fs24 \

\fs20 output(2:end,10) = num2cell(AllEpLen);
\fs24 \

\fs20 output(2:end,14) = AllStateCell;
\fs24 \

\fs20 output(2:end,15) = num2cell(col15);
\fs24 \

\fs20  
\fs24 \

\fs20 output(1,1:2) = \{\cf4 'Epoch #'\cf0 ,\cf4 'Timer'\cf0 \};
\fs24 \

\fs20 output(1,[7,14]) = \{\cf4 'Adjusted State'\cf0 \};
\fs24 \

\fs20 output(1,[10,15]) = \{\cf4 'Episode Length'\cf0 \};
\fs24 \

\fs20 output(1,[3 13]) = \{\cf4 'Time Bin'\cf0 \};
\fs24 \

\fs20  
\fs24 \

\fs20 \cf2 for\cf0  i=1:numel(output),
\fs24 \

\fs20     \cf2 if\cf0  isnan(output\{i\})
\fs24 \

\fs20         output(i) = \{[]\};
\fs24 \

\fs20     \cf2 end
\fs24 \cf0 \

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 \cf2  
\fs24 \cf0 \

\fs20 setappdata(h,\cf4 'AdjState'\cf0 ,AdjState);
\fs24 \

\fs20 setappdata(h,\cf4 'TimeBins'\cf0 ,Bins);
\fs24 \

\fs20 setappdata(h,\cf4 'AllEpLen'\cf0 ,AllEpLen);
\fs24 \

\fs20 setappdata(h,\cf4 'AdjustedStateSheet'\cf0 ,output);
\fs24 \

\fs20  
\fs24 \

\fs20  
\fs24 \
