\fs20 \cf3 %Creates combined output sheet
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf2 function\cf0  CombineOutputs(handles,wbar)
\fs24 \

\fs20  
\fs24 \

\fs20 nFiles = get(handles.Num_Files_Pop,\cf4 'Value'\cf0 );
\fs24 \

\fs20 fn = getappdata(handles.output,\cf4 'Files'\cf0 );
\fs24 \

\fs20 p = getappdata(handles.output,\cf4 'Paths'\cf0 );
\fs24 \

\fs20 Delta = [];
\fs24 \

\fs20 Gamma = [];
\fs24 \

\fs20 State = [];
\fs24 \

\fs20  
\fs24 \

\fs20 \cf2 if\cf0  get(handles.EMG_Pop,\cf4 'Value'\cf0 )==2
\fs24 \

\fs20     s = 1;
\fs24 \

\fs20 \cf2 else
\fs24 \cf0 \

\fs20     s = 0;
\fs24 \

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 \cf2  
\fs24 \cf0 \

\fs20 \cf2  
\fs24 \cf0 \

\fs20 \cf2 for\cf0  i=1:numel(fn),
\fs24 \

\fs20     waitbar(.4*i/nFiles,wbar,[\cf4 'Loading File #'\cf0  num2str(i) \cf4 '...'\cf0 ]);
\fs24 \

\fs20     [dataIn\{i\},header\{i\}] = xlsread([p\{i\} fn\{i\}]);
\fs24 \

\fs20     Delta = [Delta;dataIn\{i\}(:,4+s)];
\fs24 \

\fs20     Gamma = [Gamma;dataIn\{i\}(:,8+s)];
\fs24 \

\fs20     State = [State;dataIn\{i\}(:,2)];
\fs24 \

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 EpochNum = (1:numel(State))';
\fs24 \

\fs20 head = header\{1\};
\fs24 \

\fs20 data_out(1,:) = head;
\fs24 \

\fs20 nextRowNum = 2;
\fs24 \

\fs20 \cf2 for\cf0  i=1:numel(fn),
\fs24 \

\fs20     tmp = dataIn\{i\};
\fs24 \

\fs20     tmp(:,1) = (nextRowNum-1):(nextRowNum+size(tmp,1)-2);
\fs24 \

\fs20     data_out(nextRowNum:(nextRowNum+size(tmp,1)-1),:) = num2cell(tmp);
\fs24 \

\fs20     nextRowNum = (nextRowNum+size(tmp,1));
\fs24 \

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 a = cellfun(@(x) x>3,data_out(2:end,2));
\fs24 \

\fs20 Delta(a) = nan;
\fs24 \

\fs20 Gamma(a) = nan;
\fs24 \

\fs20 State(a)=State(a)-3;
\fs24 \

\fs20 a(end+1) = 0;
\fs24 \

\fs20 a = circshift(a,1);
\fs24 \

\fs20 data_out(a,3:end) = \{[]\};
\fs24 \
\pard\pardeftab720

\fs20 \cf3 %revert artifacts to parent state
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0 data_out(a,2) = num2cell(cellfun(@(x) x-3,data_out(a,2)));
\fs24 \

\fs20  
\fs24 \

\fs20 h = handles.output;
\fs24 \

\fs20 setappdata(h,\cf4 'EpochNum'\cf0 ,EpochNum)
\fs24 \

\fs20 setappdata(h,\cf4 'State'\cf0 ,State)
\fs24 \

\fs20 setappdata(h,\cf4 'Delta'\cf0 ,Delta)
\fs24 \

\fs20 setappdata(h,\cf4 'Gamma'\cf0 ,Gamma)
\fs24 \

\fs20 setappdata(h,\cf4 'CombinedOutput'\cf0 ,data_out)
\fs24 \

\fs20  
\fs24 \

\fs20  
\fs24 \
\pard\pardeftab720

\fs20 \cf3 %creates episode analysis sheet
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf2 function\cf0  makeEpisodeAnalysis(handles)
\fs24 \

\fs20 h = handles.output;
\fs24 \

\fs20 EpochDur = get(handles.Epoch_Dur_Pop,\cf4 'Value'\cf0 );
\fs24 \

\fs20 EpochNum = getappdata(h,\cf4 'EpochNum'\cf0 );
\fs24 \

\fs20 Delta = getappdata(h,\cf4 'Delta'\cf0 );
\fs24 \

\fs20 State = getappdata(h,\cf4 'State'\cf0 );
\fs24 \

\fs20 StartCrit = get(handles.Ep_Start_Pop,\cf4 'Value'\cf0 )*EpochDur;
\fs24 \

\fs20  
\fs24 \

\fs20 ret = findEpisodes(State,Delta,[],EpochDur,StartCrit);
\fs24 \

\fs20  
\fs24 \

\fs20 EpState = ret(:,1);
\fs24 \

\fs20 EpStart = ret(:,2);
\fs24 \

\fs20 EpLen = ret(:,3);
\fs24 \

\fs20 Incursions = ret(:,4);
\fs24 \

\fs20 Timer = 0:EpochDur:EpochDur*(numel(EpochNum)-1);
\fs24 \

\fs20 TimeStr = datestr(Timer./86400,\cf4 'HH:MM:SS'\cf0 );
\fs24 \

\fs20 \cf2 for\cf0  i=1:size(TimeStr,1),
\fs24 \

\fs20     hh = str2double(TimeStr(i,1:2));
\fs24 \

\fs20     hh = hh+floor(Timer(i)./86400)*24;
\fs24 \

\fs20     \cf2 if\cf0  hh<10
\fs24 \

\fs20         HH = [\cf4 '0'\cf0  num2str(hh)];
\fs24 \

\fs20     \cf2 else
\fs24 \cf0 \

\fs20         HH = num2str(hh);
\fs24 \

\fs20     \cf2 end
\fs24 \cf0 \

\fs20     TimeStr(i,1:2) = HH;
\fs24 \

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 \cf2  
\fs24 \cf0 \

\fs20 col6 = cell(numel(State),1);
\fs24 \

\fs20 col7 = col6;
\fs24 \

\fs20 row1 = cell(1,size(ret,1));
\fs24 \

\fs20 EpisodeArr = zeros(2+max(EpLen),size(ret,1));
\fs24 \

\fs20 EpisodeArr(1,:) = EpLen';
\fs24 \

\fs20 EpisodeArr(2,:) = Incursions';
\fs24 \

\fs20  
\fs24 \

\fs20 \cf2 for\cf0  i=1:numel(EpStart),
\fs24 \

\fs20     ss = getStateStr(EpState(i));
\fs24 \

\fs20     row1\{i\} = ss;
\fs24 \

\fs20     \cf2 if\cf0  i>1,
\fs24 \

\fs20         ss2 = getStateStr(EpState(i-1));
\fs24 \

\fs20         col6\{EpStart(i)-1\} = [\cf4 'End '\cf0  ss2];
\fs24 \

\fs20     \cf2 end
\fs24 \cf0 \

\fs20     col6\{EpStart(i)\} = [\cf4 'Begin '\cf0  ss];
\fs24 \

\fs20     col7\{EpStart(i)\} = EpLen(i);
\fs24 \

\fs20     epDelta = Delta(EpStart(i):EpStart(i)+EpLen(i)-1);
\fs24 \

\fs20     EpisodeArr(3:2+EpLen(i),i) = epDelta;
\fs24 \

\fs20     EpisodeArr(2,i) = EpisodeArr(2,i)+sum(isnan(epDelta));
\fs24 \

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 EpisodeArr(EpisodeArr==0) = NaN;
\fs24 \

\fs20 r2 = EpisodeArr(2,:);
\fs24 \

\fs20 r2(isnan(r2)) = 0;
\fs24 \

\fs20 EpisodeArr(2,:) = r2;
\fs24 \

\fs20 outputArr = cell(numel(Delta)+1,numel(EpStart)+9);
\fs24 \

\fs20 outputArr(1,1:4) = \{\cf4 'Epoch #'\cf0 ,\cf4 'Timer'\cf0 ,\cf4 'Delta'\cf0 ,\cf4 'State'\cf0 \};
\fs24 \

\fs20 outputArr(2:end,1) = num2cell(EpochNum);
\fs24 \

\fs20 outputArr(2:end,2) = cellstr(TimeStr);
\fs24 \

\fs20 outputArr(2:end,3) = num2cell(Delta);
\fs24 \

\fs20 outputArr(2:end,4) = num2cell(State);
\fs24 \

\fs20 outputArr(2:end,6) = col6;
\fs24 \

\fs20 outputArr(2:end,7) = col7;
\fs24 \

\fs20  
\fs24 \

\fs20 outputArr(1,10:end) = row1;
\fs24 \

\fs20 outputArr(1:3,9) = \{\cf4 'Episode State'\cf0 ;\cf4 'Episode Length'\cf0 ;\cf4 'Incursions'\cf0 \};
\fs24 \

\fs20 cellEpArr = num2cell(EpisodeArr);
\fs24 \

\fs20 cellEpArr(cellfun(@(x) isnan(x),cellEpArr)) = \{[]\};
\fs24 \

\fs20 outputArr(2:1+size(EpisodeArr,1),10:end) = cellEpArr;
\fs24 \

\fs20 \cf2 for\cf0  i=1:numel(outputArr),
\fs24 \

\fs20     \cf2 if\cf0  isnan(outputArr\{i\})
\fs24 \

\fs20         outputArr(i) = \{[]\};
\fs24 \

\fs20     \cf2 end
\fs24 \cf0 \

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 \cf2  
\fs24 \cf0 \

\fs20 setappdata(h,\cf4 'EpState'\cf0 ,EpState);
\fs24 \

\fs20 setappdata(h,\cf4 'EpStart'\cf0 ,EpStart);
\fs24 \

