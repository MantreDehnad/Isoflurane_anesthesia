\fs20 AA = getappdata(h,\cf4 'EpLen'\cf0 );
\fs24 \

\fs20  
\fs24 \

\fs20 n = numel(unique(J));
\fs24 \

\fs20  
\fs24 \

\fs20 Ntable = zeros(n,4);
\fs24 \

\fs20 Stable = zeros(n,4);
