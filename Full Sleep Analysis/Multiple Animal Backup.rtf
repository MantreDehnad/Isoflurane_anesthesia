\fs24 \

\fs20     output(1,3*i-2) = \{mouseID\};
\fs24 \

\fs20     output(2:numel(lens)+1,3*i-1) = num2cell(lens);
\fs24 \

\fs20     
\fs24 \

\fs20    
\fs24 \

\fs20     output(2:numel(lens)+1,3*N+2+i) = num2cell(lens);
\fs24 \

\fs20     output(1,3*N+2+i) = \{mouseID\};
\fs24 \

\fs20     output(2:numel(bins)+1,3*N+2) = num2cell(bins);
\fs24 \

\fs20     
\fs24 \

\fs20     
\fs24 \

\fs20     output(3:numel(bins)+2,4*N+3+2*i) = num2cell(bins);
