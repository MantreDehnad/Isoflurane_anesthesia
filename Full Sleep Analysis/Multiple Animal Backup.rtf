\fs20 \cf2 function\cf0  [output] = makeCumulativeSWS(State,Len,maxDur,maxSize,N,ids)
\fs24 \
\pard\pardeftab720

\fs20 \cf3 %all calculations
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0 bins = 8:4:max(maxDur)+4;
\fs24 \

\fs20 freqs = cell(N,1);
\fs24 \

\fs20 sumP = cell(N,1);
\fs24 \

\fs20 cumulP = cell(N,1);
\fs24 \
\pard\pardeftab720

\fs20 \cf2 for\cf0  i=1:N,
\fs24 \
\pard\pardeftab720

\fs20 \cf0     freq = zeros(numel(bins),1);
\fs24 \

\fs20     lens = Len\{i\};
\fs24 \

\fs20     lastBin = 0;
\fs24 \

\fs20     \cf2 for\cf0  j=1:numel(bins),
\fs24 \

\fs20         freq(j) = sum(lens<=bins(j) & lens>lastBin);
\fs24 \

\fs20         lastBin = bins(j);
\fs24 \

\fs20     \cf2 end\cf0  
\fs24 \

\fs20     freqs\{i\} = freq;
\fs24 \

\fs20     sumP\{i\} = freq./sum(freq) * 100;
\fs24 \

\fs20     cumulP\{i\} = cumsum(sumP\{i\});
\fs24 \
\pard\pardeftab720

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 \cf2  
\fs24 \cf0 \
\pard\pardeftab720

