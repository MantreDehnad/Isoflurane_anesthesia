\fs20 \cf3 % --- Executes on button press in Fit_SWA_Push.
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf2 function\cf0  Fit_SWA_Push_Callback(hObject, eventdata, handles)
\fs24 \
\pard\pardeftab720

\fs20 \cf3 % hObject    handle to Fit_SWA_Push (see GCBO)
\fs24 \cf0 \

\fs20 \cf3 % eventdata  reserved - to be defined in a future version of MATLAB
\fs24 \cf0 \

\fs20 \cf3 % handles    structure with handles and user data (see GUIDATA)
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0 LnNormD = getappdata(handles.output,\cf4 'lnNormDelta'\cf0 );
\fs24 \

\fs20 time = getappdata(handles.output,\cf4 'fitTime'\cf0 );
\fs24 \

\fs20 time(end+1) = time(end)+time(2);
\fs24 \

\fs20 time = time(2:end);
\fs24 \

\fs20 NormDelta = exp(LnNormD);
\fs24 \

\fs20  
\fs24 \

\fs20 t1 = 3.5;
\fs24 \

\fs20 t2 = time(fix(end-end/4));
\fs24 \

\fs20 lim_pop = Set_Lim_Popup(t1,t2,time,NormDelta);
\fs24 \

\fs20 waitfor(lim_pop,\cf4 'Visible'\cf0 ,\cf4 'off'\cf0 );
\fs24 \

\fs20 t1 = getappdata(lim_pop,\cf4 'Limit1'\cf0 );
\fs24 \

\fs20 t2 = getappdata(lim_pop,\cf4 'Limit2'\cf0 );
\fs24 \

\fs20 delete(lim_pop);
\fs24 \

\fs20 fragStart = find(time>=t1,1,\cf4 'first'\cf0 );
\fs24 \

\fs20 fragStop = find(time<=t2,1,\cf4 'last'\cf0 );
\fs24 \

\fs20  
\fs24 \

\fs20 y1 = NormDelta(fragStart:fragStop);
\fs24 \

\fs20  
\fs24 \
\pard\pardeftab720

\fs20 \cf3 %deinfe x1 as time in minutes with start of fragment at t=1/6
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0 x1 = (time(1):time(1):numel(y1)*time(1))';
\fs24 \

\fs20  
\fs24 \
\pard\pardeftab720

\fs20 \cf3 %fit fragment to y= (y0-plt)*e^(-K*x) + plt to get y0, plt, and K
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0 F = @(c,x)(c(3)-c(1))*exp(-x*c(2)) + c(1);
\fs24 \

\fs20 opts = optimset(\cf4 'Display'\cf0 ,\cf4 'off'\cf0 );
\fs24 \

\fs20 c = lsqcurvefit(F,[min(y1) 1 y1(1)],x1,y1,[],[],opts);
\fs24 \

\fs20  
\fs24 \
\pard\pardeftab720

\fs20 \cf3 %then we put the fragment back into the time frame of the full dataset and
\fs24 \cf0 \

\fs20 \cf3 %refit holding K constant to get the plateau and y0
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0 x2 = time(fragStart:fragStop);
\fs24 \

\fs20 y2 = y1(2:end);
\fs24 \

\fs20 x2 = x2(2:end);
\fs24 \

\fs20 F2 = @(k,x)(k(2)-k(1))*exp(-x*c(2)) + k(1);
\fs24 \

\fs20 k = lsqcurvefit(F2,[min(y1) c(3)],x2,y2,[],[],opts);
\fs24 \

\fs20  
\fs24 \

\fs20  
\fs24 \

\fs20  
\fs24 \
\pard\pardeftab720

\fs20 \cf3 %transform y2 -> y3 according to y3 = (y2-k(1))/(k(2)-k(1))
\fs24 \cf0 \

\fs20 \cf3 %this normalizes the fragment to have a span on 1
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0 y3 = (y2-k(1))/(k(2)-k(1));
\fs24 \

\fs20  
\fs24 \

\fs20  
\fs24 \
\pard\pardeftab720

\fs20 \cf3 %now fit y3 to y3 = exp(-K*x) to get K for a normalized fit
\fs24 \cf0 \

\fs20 \cf3 %tau = 1/K with units of minutes
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0 F3 = @(l,x)exp(-l(1)*x);
\fs24 \

\fs20 [l,resnorm] = lsqcurvefit(F3,c(2),x2,y3,[],[],opts);
\fs24 \

\fs20 tau = 1/l;
\fs24 \

\fs20 Rsquared = 1 - resnorm/norm(y3-mean(y3))^2;
\fs24 \

\fs20  
\fs24 \
\pard\pardeftab720

\fs20 \cf3 %Plot resutls
\fs24 \cf0 \

\fs20 \cf3  
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0 h = figure;
\fs24 \

\fs20 normSWA = (NormDelta-k(1))/(k(2)-k(1));
\fs24 \

\fs20 plot(time,normSWA,\cf4 'r.'\cf0 );
\fs24 \

\fs20 hold \cf4 on
\fs24 \cf0 \

\fs20 Yfit = exp(-time/tau);
\fs24 \

\fs20 plot(x2,y3,\cf4 'b.'\cf0 )
\fs24 \

\fs20 plot(time, Yfit,\cf4 'r-'\cf0 )
\fs24 \

\fs20 legend(\cf4 'Normalized Average SWS episode'\cf0 ,\cf4 'Fitted Fragment'\cf0 ,\cf4 'Fit'\cf0 ,\cf4 'Location'\cf0 ,\cf4 'NorthEast'\cf0 )
\fs24 \

\fs20 hold \cf4 off
\fs24 \cf0 \

\fs20 title(\{\cf4 'SWS Normalized Delta Decay Fit'\cf0 ,sprintf(\cf4 'Tau = %0.2f Minutes'\cf0 ,tau)\});
\fs24 \

\fs20 xlabel(\cf4 'Time (Sec)'\cf0 );
\fs24 \

\fs20 ylabel(\cf4 'Normalized SWA Power'\cf0 );
\fs24 \

\fs20 ylim([min(normSWA) 1]);
\fs24 \

\fs20  
\fs24 \
\pard\pardeftab720

\fs20 \cf3 %save and display results
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0 Yint = k(2);
\fs24 \

\fs20 plt = k(1);
\fs24 \

\fs20 Kval = 1/tau;
\fs24 \

\fs20 timeStart = time(fragStart);
\fs24 \

\fs20 timeStop = time(fragStop);
\fs24 \

\fs20  
\fs24 \

\fs20 output = cell(8,2);
\fs24 \

\fs20 output(:,1) = \{\cf4 'Fit of SWA Decay of SWS episodes'\cf0 ;\cf4 'Fragment Start Time (min)'\cf0 ;\cf4 'Fragment Stop Time (min)'\cf0 ;\cf4 'Tau (min)'\cf0 ;\cf4 'K-Value (1/min)'\cf0 ;\cf4 'Plateau'\cf0 ;\cf4 'Y_0'\cf0 ;\cf4 'R-Squared'\cf0 \};
\fs24 \

\fs20 output(2:end,2) = num2cell([timeStart;timeStop;tau;Kval;plt;Yint;Rsquared]);
\fs24 \

\fs20  
\fs24 \

\fs20  
\fs24 \

\fs20  
\fs24 \

\fs20 outstr = sprintf(\cf4 'Fit of SWA Decay of SWS episodes\\n\\n\\tFragment Start Time (min): %0.2f\\n\\tFragment Stop Time (min): %0.2f\\n\\tTau (min): %0.2f\\n\\tK-Value (1/min): %0.2f\\n\\tPlateau: %0.2f\\n\\tY_0: %0.2f\\n\\tR-Squared: %0.2f'\cf0 ,\cf2 ...
\fs24 \cf0 \

\fs20     timeStart,timeStop,tau,Kval,plt,Yint,Rsquared);
\fs24 \

\fs20  
\fs24 \

\fs20 q = \cf4 'Yes'\cf0 ;
\fs24 \
\pard\pardeftab720

\fs20 \cf2 if\cf0  ~isfield(getappdata(handles.output),\cf4 'FitStr'\cf0 )
\fs24 \
\pard\pardeftab720

\fs20 \cf0 msgbox(\{outstr,\cf4 ''\cf0 ,\cf4 'These fit results have been saved to your SWA decay File.'\cf0 ,\cf2 ...
\fs24 \cf0 \

\fs20     \cf4 'If you are not satified with this fit you can click the fit button again.'\cf0 ,\cf2 ...
\fs24 \cf0 \

\fs20     \cf4 'Also please take a moment to save the produced figure associated with the fit.'\cf0 \});
\fs24 \
\pard\pardeftab720

\fs20 \cf2 else
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0     prevFit = getappdata(handles.output,\cf4 'FitStr'\cf0 );
\fs24 \

\fs20     newOutStr = [\cf4 'Previous Fit: '\cf0  char(10) prevFit char(10) char(10) \cf4 'New Fit: '\cf0  char(10) outstr char(10) char(10) \cf4 'Should the old fit be replaced?'\cf0 ];
\fs24 \

\fs20     
\fs24 \

\fs20     q = questdlg(newOutStr,\cf4 'Keep New Fit?'\cf0 ,\cf4 'Yes'\cf0 ,\cf4 'No'\cf0 ,\{\cf4 'Yes'\cf0 \});
\fs24 \
\pard\pardeftab720

\fs20 \cf2 end
\fs24 \cf0 \

\fs20 \cf2  
\fs24 \cf0 \

\fs20 \cf2 if\cf0  strcmp(q,\cf4 'Yes'\cf0 )
\fs24 \
\pard\pardeftab720

\fs20 \cf0     status = xlswrite(getappdata(handles.output,\cf4 'outFile'\cf0 ),output,\cf4 'SWS Decay Fit'\cf0 );
\fs24 \

\fs20     \cf2 if\cf0  ~status
\fs24 \

\fs20         errordlg(\cf4 'Writing fit to excel file failed.'\cf0 )
\fs24 \

\fs20     \cf2 end
\fs24 \cf0 \

\fs20     setappdata(handles.output,\cf4 'FitStr'\cf0 ,outstr);
\fs24 \
\pard\pardeftab720

\fs20 \cf2 end
\fs24 \cf0 \
\pard\pardeftab720

\fs20 \cf0  
\fs24 \

\fs20  
\fs24 \
\pard\pardeftab720

